
# Copy to .env.local (never commit — gitignored)
# Restart `yarn dev` after any change to NEXT_PUBLIC_* (baked at build time).

# ─── Local dev → local FixoraB (default) ───────────────────────────────────
# yarn dev: http://localhost:3000
# FixoraB:  http://localhost:2000/graphql

NEXT_PUBLIC_GRAPHQL_URL=http://localhost:2000/graphql
NEXT_PUBLIC_API_URL=http://localhost:2000
NEXT_PUBLIC_WS_URL=ws://localhost:2000
NEXT_PUBLIC_APP_URL=http://localhost:3000
REACT_APP_API_URL=http://localhost:2000

# ─── Local dev → production API (avoids CORS via Next.js proxy) ─────────────
# Uncomment all lines below AND comment out the local FixoraB block above.
# Restart yarn dev after change.

# GRAPHQL_PROXY_TARGET=https://fixoranext.com
# NEXT_PUBLIC_GRAPHQL_URL=http://localhost:3000/graphql
# NEXT_PUBLIC_API_URL=http://localhost:3000
# NEXT_PUBLIC_WS_URL=wss://fixoranext.com/graphql/ws
# NEXT_PUBLIC_APP_URL=http://localhost:3000
# REACT_APP_API_URL=https://fixoranext.com

# ─── Production VPS (/home/fixora-project/fixoraF/.env.local) ───────────────
# Use ONLY these values on the server — never localhost.
# After editing: bash deploy.sh (yarn build rebakes NEXT_PUBLIC_*).

# NEXT_PUBLIC_GRAPHQL_URL=https://fixoranext.com/graphql
# NEXT_PUBLIC_API_URL=https://fixoranext.com
# NEXT_PUBLIC_APP_URL=https://fixoranext.com
# NEXT_PUBLIC_WS_URL=wss://fixoranext.com/graphql/ws
# REACT_APP_API_URL=https://fixoranext.com
# Do NOT set GRAPHQL_PROXY_TARGET on production.

NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# Google Cloud Console → Credentials → OAuth client → Authorized redirect URIs must include:
#   http://localhost:3000/oauth/google
#   https://fixoranext.com/oauth/google
# (Desktop still uses popup; phones use this redirect callback.)
NEXT_PUBLIC_KAKAO_JS_KEY=
NEXT_PUBLIC_APPLE_CLIENT_ID=

# Server-only (not NEXT_PUBLIC_) — Kakao Mobility road routing for /api/map/directions
# Same Kakao app as JS key: Developers → App → REST API key. Enable Kakao Mobility.
# Local: copy from FixoraB root .env (KAKAO_REST_API_KEY=...)
KAKAO_REST_API_KEY=
